# ---------------------------------------------------------------------------
# AdGenie Pro configuration
# Copy to .env and fill in. Every integration is optional: anything left blank
# falls back to the sandbox simulator so the platform still runs end to end.
# ---------------------------------------------------------------------------

ENVIRONMENT=dev
DATABASE_URL=sqlite:///./adgenie.db
SECRET_KEY=change-me-to-something-random

# The public origin ads and network postbacks reach. Must be HTTPS in
# production: this is the URL inside every ad's final-URL field.
PUBLIC_BASE_URL=https://track.yourdomain.com

# --- access control --------------------------------------------------------
# When set, every /api route requires this key in an X-API-Key header. These
# routes launch campaigns and move budgets, so set it for anything reachable
# beyond localhost. The dashboard reads it from localStorage:
#   localStorage.setItem("adgenie_api_key", "...")
API_KEY=
# Browser origins allowed to call the API. "*" is only safe while API_KEY is
# unset and the server is bound to localhost.
CORS_ORIGINS=["*"]

# --- safety rails ----------------------------------------------------------
# While true, no mutation is sent to a live ad account. The optimizer still
# runs and records what it would do. Turn this off deliberately.
DRY_RUN=true
# Budget changes larger than this are held for human approval.
AUTO_APPLY_BUDGET_CEILING_USD=50
# No sequence of increases may push committed daily spend past this.
GLOBAL_DAILY_BUDGET_CAP_USD=500

# --- ad copy (optional) ----------------------------------------------------
# Without a key, copy is generated from the built-in angle templates.
ANTHROPIC_API_KEY=
COPYWRITER_MODEL=claude-opus-5
COPYWRITER_EFFORT=high

# --- Meta (optional) -------------------------------------------------------
# A system-user token with ads_management, ads_read and business_management.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=          # digits only, no "act_" prefix
META_PAGE_ID=                # required to create ad creatives
META_PIXEL_ID=               # required for the Conversions API
META_API_VERSION=v21.0

# --- Google Ads (optional) -------------------------------------------------
GOOGLE_DEVELOPER_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CUSTOMER_ID=          # dashes are stripped automatically
GOOGLE_LOGIN_CUSTOMER_ID=    # the manager account, if you use one
GOOGLE_CONVERSION_ACTION_ID= # for offline conversion upload
GOOGLE_API_VERSION=v18

# --- destination auditing --------------------------------------------------
# Check the landing page before a launch sends paid traffic to it. The
# destination is what gets an ad account banned, so this defaults to on. Turn
# it off only where the page cannot be reached from this server.
AUDIT_LANDING_PAGES=true
LANDING_PAGE_RECHECK_HOURS=24

# --- media generation (kie.ai, optional) -----------------------------------
# Without a key, images are simulated placeholders at the correct dimensions,
# so the pipeline still runs end to end.
KIE_API_KEY=
KIE_IMAGE_MODEL=google/nano-banana-pro-text-to-image
KIE_VIDEO_MODEL=veo3.1-fast
KIE_POLL_TIMEOUT_SECONDS=600
# Generated URLs expire within about a day, so assets are downloaded here.
MEDIA_STORAGE_DIR=./media
# Where a platform can fetch stored assets. Required to attach imagery to a
# live ad: Meta and Google fetch the image, they do not read your disk.
MEDIA_PUBLIC_BASE_URL=

# --- competitor research (Meta Ad Library) ---------------------------------
# Uses META_ACCESS_TOKEN with ads_read. Commercial ads are archived for the EU
# and UK only; elsewhere the archive carries political and issue ads.
AD_LIBRARY_COUNTRY_CODES=["GB","IE","DE","FR","NL","ES","IT"]
# An ad still running after this many days is treated as proven.
AD_LIBRARY_PROVEN_DAYS=30

# --- affiliate networks ----------------------------------------------------
# Shared secret the network must present on every conversion postback.
# This endpoint writes the revenue the optimizer spends against; leaving it
# guessable is a way to make the system scale a losing campaign.
POSTBACK_SECRET=change-me-to-something-random
CLICKBANK_API_KEY=
CLICKBANK_NICKNAME=

# --- funnels ---------------------------------------------------------------
# Funnel steps are defined per offer via the CLI or API, not here. The postback
# secret above also guards the opt-in and funnel-event endpoints, which write
# the lead counts the optimizer spends against.

# --- optimizer -------------------------------------------------------------
TARGET_ROAS=1.30
OPTIMIZER_LOOKBACK_DAYS=7
OPTIMIZER_MIN_CLICKS=30
OPTIMIZER_CREDIBLE_LEVEL=0.90
SCALE_STEP=0.20
THROTTLE_STEP=0.25
KILL_PAYOUT_MULTIPLE=1.5
ACTION_COOLDOWN_HOURS=12
