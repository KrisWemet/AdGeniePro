# Copy to .env on the deployment server. Never commit the filled-in file.
# Generate EACH long secret separately: python -c 'import secrets; print(secrets.token_hex(32))'
PUBLIC_HOSTNAME=
POSTGRES_PASSWORD=
API_KEY=
SECRET_KEY=
POSTBACK_SECRET=
DRY_RUN=true
# Choose both budget settings explicitly before deployment (amounts in USD).
GLOBAL_DAILY_BUDGET_CAP_USD=
AUTO_APPLY_BUDGET_CEILING_USD=0
AUDIT_LANDING_PAGES=true
CLICKBANK_NICKNAME=
# Match the secret configured in ClickBank; uppercase A-Z / 0-9, maximum 16 chars.
CLICKBANK_INS_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
META_PIXEL_ID=
KIE_API_KEY=
# Optional: missing copywriter credentials use deterministic templates.
ANTHROPIC_API_KEY=
