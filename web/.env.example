# --- Supabase (required) ---
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (required) ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-4-8

# --- Meta Marketing API (required to build/run campaigns) ---
FB_ACCESS_TOKEN=
FB_AD_ACCOUNT_ID=          # numeric id, no "act_" prefix
FB_PAGE_ID=                # the Facebook Page ads run under
# META_API_VERSION=v23.0

# --- ClickBank ---
CLICKBANK_NICKNAME=        # your affiliate nickname, used to build hoplinks
# CLICKBANK_DEV_KEY=       # optional: enables automatic revenue sync
# CLICKBANK_API_KEY=
# CLICKBANK_FEED_URL=

# --- Dashboard & cron security (required) ---
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
CRON_SECRET=
